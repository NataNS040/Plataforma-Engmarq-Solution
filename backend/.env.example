# JSON array of explicit frontend origins. No trailing URL path.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional for /health. Set URL and anon key together to enable Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_TIMEOUT_SECONDS=10

# Required for user provisioning; modern sb_secret_ key, backend only.
# Never commit, send to a browser, use a VITE_ prefix or copy to frontend/.env.
SUPABASE_SECRET_KEY=

# Temporary legacy fallback, used only when SUPABASE_SECRET_KEY is absent.
SUPABASE_SERVICE_ROLE_KEY=
