# JSON array of explicit frontend origins. No trailing URL path.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional for /health. Set URL and anon key together to enable Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_TIMEOUT_SECONDS=10

# Optional; only for explicitly privileged server-side operations.
# Never use a VITE_ prefix or copy this key to frontend/.env.
SUPABASE_SERVICE_ROLE_KEY=
